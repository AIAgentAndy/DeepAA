#!/usr/bin/expect -f

log_user 0
set timeout 20
set account [lindex $argv 0]
set label [lindex $argv 1]
set service [lindex $argv 2]
set secret [string trimright [read stdin] "\r\n"]

if {[string length $secret] == 0} {
  exit 2
}

spawn -noecho /usr/bin/security add-generic-password -U -a $account -s $service -l $label -w
expect {
  -re "password data for new item:" {
    send -- "$secret\r"
    exp_continue
  }
  -re "retype password for new item:" {
    send -- "$secret\r"
    exp_continue
  }
  eof {
    set result [wait]
    exit [lindex $result 3]
  }
  timeout {
    exit 124
  }
}
